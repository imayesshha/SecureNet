{
  "name": "securenet",
  "version": "1.0.0",
  "description": "SecureNet Fullstack - React Frontend + Express Backend Security Tools",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently \"npm run server:dev\" \"wait-on tcp:localhost:5000 && cd client && npm i && npm run dev\"",
    "server:dev": "nodemon server.js",
    "build": "cd client && npm ci && npm run build",
    "preview": "npm run build && npm start",
    "deploy": "npm run build && vercel --prod"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imayesshha/SecureNet.git"
  },
  "keywords": ["security", "react", "express", "mongodb", "vercel"],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/imayesshha/SecureNet/issues"
  },
  "homepage": "https://github.com/imayesshha/SecureNet#readme",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.3.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0"
  }
}
